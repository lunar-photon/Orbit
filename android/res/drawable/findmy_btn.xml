<?xml version="1.0" encoding="utf-8"?>
<!-- Find my: rounded rectangle action button -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/o_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/o_raised" />
            <stroke android:width="1dp" android:color="@color/o_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
