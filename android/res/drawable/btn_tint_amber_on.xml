<?xml version="1.0" encoding="utf-8"?>
<!-- Keep-awake tile while it is on: solid amber edge so the state reads at a glance -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/o_ripple">
    <item><shape android:shape="rectangle"><solid android:color="#33FDBA74"/><stroke android:width="1.5dp" android:color="@color/o_amber"/><corners android:radius="18dp"/></shape></item>
    <item android:id="@android:id/mask"><shape android:shape="rectangle"><solid android:color="#FFFFFFFF"/><corners android:radius="18dp"/></shape></item>
</ripple>
