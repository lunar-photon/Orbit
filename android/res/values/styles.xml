<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Orbit theme: graphite ground, one accent, Geist type. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/o_ground</item>
        <item name="android:statusBarColor">@color/o_ground</item>
        <item name="android:navigationBarColor">@color/o_ground</item>
        <item name="android:colorBackground">@color/o_ground</item>
        <item name="android:colorAccent">@color/o_accent</item>
        <item name="android:colorPrimary">@color/o_ground</item>
        <item name="android:colorPrimaryDark">@color/o_ground</item>
        <item name="android:colorControlNormal">@color/o_text_3</item>
        <item name="android:colorControlActivated">@color/o_accent</item>
        <item name="android:colorControlHighlight">@color/o_ripple</item>
        <item name="android:textColorPrimary">@color/o_text</item>
        <item name="android:textColorSecondary">@color/o_text_2</item>
        <item name="android:textColorHint">@color/o_text_3</item>
        <item name="android:textColorHighlight">@color/o_accent_tint</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppDialogTheme" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorBackground">@color/o_surface</item>
        <item name="android:colorAccent">@color/o_accent</item>
        <item name="android:textColorPrimary">@color/o_text</item>
        <item name="android:textColorSecondary">@color/o_text_2</item>
        <item name="android:colorControlActivated">@color/o_accent</item>
        <item name="android:buttonBarButtonStyle">@style/DialogButton</item>
        <item name="android:windowTitleStyle">@style/DialogTitle</item>
    </style>

    <!-- Full-screen page (browse, search, screen, settings) that slides in over the app -->
    <style name="PageTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/o_ground</item>
        <item name="android:statusBarColor">@color/o_ground</item>
        <item name="android:navigationBarColor">@color/o_ground</item>
        <item name="android:colorAccent">@color/o_accent</item>
        <item name="android:colorControlActivated">@color/o_accent</item>
        <item name="android:colorControlHighlight">@color/o_ripple</item>
        <item name="android:textColorPrimary">@color/o_text</item>
        <item name="android:textColorHint">@color/o_text_3</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
        <item name="android:windowAnimationStyle">@style/PageAnimation</item>
    </style>

    <style name="PageAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="DialogTitle" parent="@android:style/TextAppearance.DeviceDefault.DialogWindowTitle">
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/o_text</item>
    </style>

    <style name="DialogButton" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:textColor">@color/o_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/geist_medium</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Buttons -->
    <style name="Btn" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">@font/geist_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Btn.Primary">
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">11sp</item>
        <item name="android:autoSizeMaxTextSize">15sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:background">@drawable/btn_approve</item>
        <item name="android:textColor">@color/o_on_accent</item>
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:drawableTint">@color/o_on_accent</item>
    </style>
    <style name="Btn.Secondary">
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">11sp</item>
        <item name="android:autoSizeMaxTextSize">15sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:background">@drawable/btn_tonal</item>
        <item name="android:textColor">@color/o_text</item>
        <item name="android:drawableTint">@color/o_text</item>
    </style>
    <style name="Btn.Tonal" parent="Btn.Secondary" />
    <style name="Btn.Danger">
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">11sp</item>
        <item name="android:autoSizeMaxTextSize">15sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:background">@drawable/btn_deny</item>
        <item name="android:textColor">@color/o_danger</item>
        <item name="android:drawableTint">@color/o_danger</item>
    </style>
    <style name="Btn.Ghost">
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">11sp</item>
        <item name="android:autoSizeMaxTextSize">15sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/o_text_2</item>
        <item name="android:drawableTint">@color/o_text_2</item>
    </style>
    <style name="Btn.Icon">
        <item name="android:background">@drawable/bg_circle_ghost</item>
        <item name="android:textColor">@color/o_text_2</item>
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="Btn.Key">
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:textColor">@color/o_text</item>
        <item name="android:fontFamily">@font/geist_mono_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>
    <style name="Btn.Key.Remote">
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">13sp</item>
    </style>
    <!-- Square tile with icon on top and label below (quick actions) -->
    <style name="Btn.Tile">
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">11sp</item>
        <item name="android:autoSizeMaxTextSize">13sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:background">@drawable/btn_tile</item>
        <item name="android:textColor">@color/o_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">start|bottom</item>
        <item name="android:padding">14dp</item>
        <item name="android:drawableTint">@color/o_accent</item>
        <item name="android:minHeight">84dp</item>
        <item name="android:singleLine">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">none</item>
    </style>
    <!-- Full-width list row inside a card -->
    <style name="Btn.Row">
        <item name="android:background">@drawable/btn_row</item>
        <item name="android:textColor">@color/o_text</item>
        <item name="android:fontFamily">@font/geist_regular</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:drawableTint">@color/o_text_2</item>
    </style>

    <!-- Type -->
    <style name="Text">
        <item name="android:fontFamily">@font/geist_regular</item>
        <item name="android:textColor">@color/o_text</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.Display">
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="Text.Title">
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="Text.Heading">
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Text.Secondary">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/o_text_2</item>
    </style>
    <style name="Text.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/o_text_3</item>
    </style>
    <style name="Text.Overline">
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/o_text_2</item>
    </style>
    <style name="Text.Badge">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/o_text_2</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="Text.Metric">
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="Text.Mono">
        <item name="android:fontFamily">@font/geist_mono_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/o_text_3</item>
    </style>
    <style name="Text.Tab">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/o_text_3</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Containers -->
    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="Input">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/o_text</item>
        <item name="android:textColorHint">@color/o_text_3</item>
        <item name="android:fontFamily">@font/geist_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>
    <style name="Divider">
        <item name="android:background">@color/o_raised</item>
        <item name="android:layout_height">1dp</item>
    </style>
</resources>
