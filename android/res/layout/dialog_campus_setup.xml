<?xml version="1.0" encoding="utf-8"?>
<!-- Orbit: campus Wi-Fi login details -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <TextView
        style="@style/Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Campus Wi-Fi login" />

    <TextView
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="When your phone joins the campus Wi-Fi, Orbit logs you in to its internet. Your details stay on this phone." />

    <TextView
        style="@style/Text.Overline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Your account" />

    <EditText
        android:id="@+id/et_campus_user"
        style="@style/Input"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:autofillHints="username"
        android:hint="Campus username"
        android:inputType="text"
        android:singleLine="true" />

    <EditText
        android:id="@+id/et_campus_password"
        style="@style/Input"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:autofillHints="password"
        android:hint="Password"
        android:inputType="textPassword"
        android:singleLine="true" />

    <TextView
        style="@style/Text.Overline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Login page" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_campus_gateway"
            style="@style/Input"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:fontFamily="@font/geist_mono_regular"
            android:hint="Gateway address"
            android:inputType="textUri"
            android:singleLine="true"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_campus_detect"
            style="@style/Btn.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Find" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_campus_detect_note"
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Find looks for the campus login page on the Wi-Fi you're on." />

    <TextView
        style="@style/Text.Overline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Automatic" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal">
        <TextView
            style="@style/Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Log in when the phone joins campus Wi-Fi" />
        <Switch
            android:id="@+id/switch_campus_auto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal">
        <TextView
            style="@style/Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Check again when the screen turns on" />
        <Switch
            android:id="@+id/switch_campus_screen_on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btn_campus_test"
            style="@style/Btn.Secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Test login" />
        <Button
            android:id="@+id/btn_campus_save"
            style="@style/Btn.Primary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Save" />
    </LinearLayout>
</LinearLayout>
