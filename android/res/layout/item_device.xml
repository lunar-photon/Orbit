<?xml version="1.0" encoding="utf-8"?>
<!-- Orbit: one saved laptop -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tv_device_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_tile"
        android:drawableTop="@drawable/ic_o_laptop"
        android:drawableTint="@color/o_text_2"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text=""
        android:textColor="@color/o_text_2"
        android:textSize="1sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_item_hostname"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/geist_medium"
            android:singleLine="true"
            android:text="Computer"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_item_ip"
            style="@style/Text.Mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="192.168.1.20:1760" />

        <TextView
            android:id="@+id/tv_item_status"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/geist_medium"
            android:singleLine="true"
            android:text="Active"
            android:textColor="@color/o_online" />
    </LinearLayout>

    <Button
        android:autoSizeTextType="none"
        android:id="@+id/btn_select_device"
        style="@style/Btn.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:minHeight="40dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="Select"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btn_delete_device"
        style="@style/Btn.Icon"
        android:layout_marginStart="2dp"
        android:contentDescription="Remove computer"
        android:drawableTop="@drawable/ic_o_trash"
        android:drawableTint="@color/o_text_3"
        android:paddingTop="10dp"
        android:text="" />

</LinearLayout>
