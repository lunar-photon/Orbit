<?xml version="1.0" encoding="utf-8"?>
<!-- Orbit: full-screen "find my phone" alarm -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/o_ground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:background="@drawable/bg_ring_halo">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_o_bell"
            android:tint="@color/o_accent" />
    </FrameLayout>

    <TextView
        style="@style/Text.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Find my phone" />

    <TextView
        android:id="@+id/tv_ring_subtitle"
        style="@style/Text.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Your computer is ringing this phone"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btn_dismiss_ring"
        style="@style/Btn.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="48dp"
        android:drawableStart="@drawable/ic_o_x"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:text="Stop alarm"
        android:textSize="16sp" />

    <TextView
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Or press a volume button, or unlock the phone" />

</LinearLayout>
