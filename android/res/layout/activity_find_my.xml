<?xml version="1.0" encoding="utf-8"?>
<!-- Orbit: Find my. Two tabs: the computer (its map, find it, alerts from it) and the
     settings (how this phone and the computer look out for each other) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/o_ground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btn_findmy_back"
            style="@style/Btn.Icon"
            android:contentDescription="Back"
            android:drawableTop="@drawable/ic_o_chevron_left"
            android:drawableTint="@color/o_text"
            android:paddingTop="10dp"
            android:text="" />

        <TextView
            style="@style/Text.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Locate" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/findmy_segment_track"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tab_findmy_computer"
            style="@style/Text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/findmy_segment_on"
            android:fontFamily="@font/geist_medium"
            android:gravity="center"
            android:text="Your computer"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tab_findmy_settings"
            style="@style/Text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/geist_medium"
            android:gravity="center"
            android:text="Settings"
            android:textColor="@color/o_text_2"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- the computer -->
        <ScrollView
            android:id="@+id/sv_findmy_computer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:background="@drawable/term_screen_bg"
                    android:padding="1dp">

                    <WebView
                        android:id="@+id/wv_findmy_map"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_margin="10dp"
                        android:background="@drawable/findmy_status_pill"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/tv_findmy_name"
                            style="@style/Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/geist_semibold"
                            android:singleLine="true"
                            android:text="Your computer"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_findmy_seen"
                            style="@style/Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:lineSpacingExtra="2dp"
                            android:text="Looking…" />
                    </LinearLayout>
                </FrameLayout>

                <!-- lost mode: a row like the settings, not a big button -->
                <LinearLayout
                    android:id="@+id/row_findmy_lost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/card_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="68dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:id="@+id/iv_findmy_lost"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_tile"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_o_lock"
                        android:tint="@color/o_text_2" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_findmy_lost"
                            style="@style/Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/geist_medium"
                            android:text="Mark as lost"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_findmy_lost_desc"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:text="A photo, the Wi-Fi around it and its city, every 10 minutes" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/btn_findmy_locate"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/findmy_action"
                            android:contentDescription="Locate"
                            android:src="@drawable/ic_o_refresh"
                            android:tint="@color/o_text" />

                        <TextView
                            android:id="@+id/tv_findmy_locate"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Locate"
                            android:textColor="@color/o_text_2" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/btn_findmy_ring"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/findmy_action"
                            android:contentDescription="Play sound"
                            android:src="@drawable/ic_o_volume_up"
                            android:tint="@color/o_text" />

                        <TextView
                            android:id="@+id/tv_findmy_ring"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Play sound"
                            android:textColor="@color/o_text_2" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/btn_findmy_nearby"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/findmy_action"
                            android:contentDescription="Nearby"
                            android:src="@drawable/ic_o_wifi"
                            android:tint="@color/o_text" />

                        <TextView
                            android:id="@+id/tv_findmy_nearby"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Nearby"
                            android:textColor="@color/o_text_2" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/btn_findmy_wifilab"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/findmy_action"
                            android:contentDescription="Wi-Fi Lab"
                            android:src="@drawable/ic_o_flask"
                            android:tint="@color/o_text" />

                        <TextView
                            android:id="@+id/tv_findmy_wifilab"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Wi-Fi Lab"
                            android:textColor="@color/o_text_2" />
                    </LinearLayout>

                </LinearLayout>


                <!-- the nearby finder: how alike this phone's Wi-Fi is to the computer's -->
                <LinearLayout
                    android:id="@+id/ll_findmy_meter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_findmy_meter"
                        style="@style/Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/geist_semibold"
                        android:text="Comparing Wi-Fi…"
                        android:textSize="20sp" />

                    <ProgressBar
                        android:id="@+id/pb_findmy_meter"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/findmy_meter" />

                    <TextView
                        android:id="@+id/tv_findmy_meter_sub"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="2dp"
                        android:text="" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="6dp"
                    android:text="Recent" />

                <LinearLayout
                    android:id="@+id/ll_findmy_alerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_findmy_alerts_empty"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nothing unusual. All quiet in orbit." />
            </LinearLayout>
        </ScrollView>

        <!-- the settings -->
        <ScrollView
            android:id="@+id/sv_findmy_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <TextView
                    style="@style/Text.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:text="Your computer" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:minHeight="68dp"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_tile"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_o_lock"
                        android:tint="@color/o_text_2" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/geist_medium"
                            android:text="Lock when I walk away"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_findmy_walk_desc"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:text="When this phone leaves, the computer locks itself" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_findmy_walk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:minHeight="68dp"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_tile"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_o_camera"
                        android:tint="@color/o_text_2" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/geist_medium"
                            android:text="Photo on wrong password"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_findmy_pcphoto_desc"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:text="Its webcam takes a photo and sends it here" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_findmy_pcphoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp" />
                </LinearLayout>

                </LinearLayout>

                <TextView
                    style="@style/Text.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="6dp"
                    android:text="This phone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:minHeight="68dp"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_tile"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_o_target"
                        android:tint="@color/o_text_2" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/geist_medium"
                            android:text="Share location"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_findmy_share_desc"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:text="Only your computer gets it" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_findmy_share"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:minHeight="68dp"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_tile"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_o_camera"
                        android:tint="@color/o_text_2" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/geist_medium"
                            android:text="Photo on wrong unlock"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_findmy_photo_desc"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:text="The front camera takes a photo for the computer" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_findmy_photo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:minHeight="68dp"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_tile"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_o_phone"
                        android:tint="@color/o_text_2" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/geist_medium"
                            android:text="SIM change alert"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_findmy_sim_desc"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:text="The computer hears if the SIM is swapped" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_findmy_sim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp" />
                </LinearLayout>

                </LinearLayout>

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="2dp"
                    android:text="A phone that is off or offline can't be found; the computer then shows where it was last. On the computer, Find my phone is in Orbit's tray menu." />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
