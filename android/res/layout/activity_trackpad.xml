<?xml version="1.0" encoding="utf-8"?>
<!-- Orbit: trackpad, remote keyboard and presenter controls -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/o_ground"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_trackpad_back"
            style="@style/Btn.Icon"
            android:contentDescription="Back"
            android:drawableTop="@drawable/ic_o_chevron_left"
            android:drawableTint="@color/o_text"
            android:paddingTop="10dp"
            android:text="" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trackpad" />

            <TextView
                android:id="@+id/tv_trackpad_target"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="No computer connected" />
        </LinearLayout>

        <Button
            android:autoSizeTextType="none"
            android:id="@+id/btn_trackpad_keyboard"
            style="@style/Btn.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:drawableStart="@drawable/ic_o_keyboard"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="Type"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Sensitivity -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_sensitivity"
            style="@style/Text.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sensitivity: 1.2x" />

        <Button
            android:id="@+id/btn_sens_down"
            style="@style/Btn.Icon"
            android:background="@drawable/btn_tonal"
            android:contentDescription="Lower sensitivity"
            android:drawableTop="@drawable/ic_o_minus"
            android:drawableTint="@color/o_text"
            android:paddingTop="10dp"
            android:text="" />

        <Button
            android:id="@+id/btn_sens_up"
            style="@style/Btn.Icon"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_tonal"
            android:contentDescription="Raise sensitivity"
            android:drawableTop="@drawable/ic_o_plus"
            android:drawableTint="@color/o_text"
            android:paddingTop="10dp"
            android:text="" />
    </LinearLayout>

    <!-- Touch surface (TrackpadActivity attaches the OnTouchListener here) -->
    <FrameLayout
        android:id="@+id/touchpad_surface"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="@drawable/trackpad_surface"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_o_mouse"
                android:tint="@color/o_text_3" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="One finger moves · tap to click" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Two fingers scroll · tap to right-click" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Double-tap and hold to drag" />
        </LinearLayout>
    </FrameLayout>

    <!-- Remote keyboard (toggled by Type) -->
    <LinearLayout
        android:id="@+id/layout_keyboard_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_keyboard_input"
                style="@style/Input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:hint="Type here to type on the computer"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:singleLine="true"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_key_send_text"
                style="@style/Btn.Primary"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Send"
                android:drawableTop="@drawable/ic_o_send"
                android:paddingStart="0dp"
                android:paddingTop="10dp"
                android:paddingEnd="0dp"
                android:text="" />
        </LinearLayout>

        <!-- Keys row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_key_esc"
                style="@style/Btn.Key"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/btn_tonal"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="Esc" />

            <Button
                android:id="@+id/btn_key_tab"
                style="@style/Btn.Key"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_tonal"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="Tab" />

            <Button
                android:id="@+id/btn_key_super"
                style="@style/Btn.Key"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_tonal"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="Super" />

            <Button
                android:id="@+id/btn_key_backspace"
                style="@style/Btn.Key"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_tonal"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="Bksp" />

            <Button
                android:id="@+id/btn_key_enter"
                style="@style/Btn.Key"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_tonal"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="Enter"
                android:textColor="@color/o_accent" />
        </LinearLayout>

        <!-- Keys row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_key_ctrl_c"
                style="@style/Btn.Key"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:background="@drawable/btn_tonal"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="Ctrl C" />

            <Button
                android:id="@+id/btn_key_ctrl_v"
                style="@style/Btn.Key"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_tonal"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="Ctrl V" />

            <Button
                android:id="@+id/btn_key_ctrl_z"
                style="@style/Btn.Key"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_tonal"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="Ctrl Z" />

            <Button
                android:id="@+id/btn_key_left"
                style="@style/Btn.Key"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_tonal"
                android:contentDescription="Left arrow"
                android:drawableTop="@drawable/ic_o_chevron_left"
                android:drawableTint="@color/o_text"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingTop="8dp"
                android:paddingEnd="0dp"
                android:text="" />

            <Button
                android:id="@+id/btn_key_up"
                style="@style/Btn.Key"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_tonal"
                android:contentDescription="Up arrow"
                android:drawableTop="@drawable/ic_o_chevron_up"
                android:drawableTint="@color/o_text"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingTop="8dp"
                android:paddingEnd="0dp"
                android:text="" />

            <Button
                android:id="@+id/btn_key_down"
                style="@style/Btn.Key"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_tonal"
                android:contentDescription="Down arrow"
                android:drawableTop="@drawable/ic_o_chevron_down"
                android:drawableTint="@color/o_text"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingTop="8dp"
                android:paddingEnd="0dp"
                android:text="" />

            <Button
                android:id="@+id/btn_key_right"
                style="@style/Btn.Key"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_tonal"
                android:contentDescription="Right arrow"
                android:drawableTop="@drawable/ic_o_chevron_right"
                android:drawableTint="@color/o_text"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingTop="8dp"
                android:paddingEnd="0dp"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <!-- Presenter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_slide_prev"
            style="@style/Btn.Secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_o_prev"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Back"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_slide_f5"
            style="@style/Btn.Secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/ic_o_play"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Present"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_slide_next"
            style="@style/Btn.Secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:drawableEnd="@drawable/ic_o_next"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Next"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Laser pointer: hold to point, lock to keep it on -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btn_laser_aim"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_laser_idle"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_laser_status"
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/geist_medium"
                android:text="Hold to point"
                android:textSize="15sp" />
        </FrameLayout>

        <Button
            android:autoSizeTextType="none"
            android:id="@+id/btn_lock_gyro"
            style="@style/Btn.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/ic_o_lock"
            android:drawableTint="@color/o_text_2"
            android:paddingStart="16dp"
            android:paddingEnd="18dp"
            android:text="Lock"
            android:textColor="@color/o_text_2"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Mouse buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_click_left"
            style="@style/Btn.Secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Left click" />

        <Button
            android:id="@+id/btn_click_middle"
            style="@style/Btn.Secondary"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:contentDescription="Middle click"
            android:drawableTop="@drawable/ic_o_mouse"
            android:drawableTint="@color/o_text_2"
            android:paddingStart="0dp"
            android:paddingTop="16dp"
            android:paddingEnd="0dp"
            android:text="" />

        <Button
            android:id="@+id/btn_click_right"
            style="@style/Btn.Secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Right click" />
    </LinearLayout>

</LinearLayout>
