<?xml version="1.0" encoding="utf-8"?>
<!-- Orbit: live view of the laptop webcam -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/o_ground"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_camera_back"
            style="@style/Btn.Icon"
            android:contentDescription="Back"
            android:drawableTop="@drawable/ic_o_chevron_left"
            android:drawableTint="@color/o_text"
            android:paddingTop="10dp"
            android:text="" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desk view" />

            <TextView
                android:id="@+id/tv_camera_target"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="No computer connected" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_camera_status"
            style="@style/Text.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/geist_medium"
            android:text="Connecting"
            android:textColor="@color/o_text_2" />
    </LinearLayout>

    <!-- Viewport -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="@drawable/term_screen_bg"
        android:clipChildren="true"
        android:padding="1dp">

        <ImageView
            android:id="@+id/iv_camera_feed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="Camera feed"
            android:scaleType="fitCenter" />

        <ProgressBar
            android:id="@+id/pb_camera_loading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/o_accent" />

        <TextView
            android:id="@+id/tv_camera_error"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:padding="24dp"
            android:text="Connecting to the computer camera…" />
    </FrameLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_camera_snapshot"
            style="@style/Btn.Primary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:drawableStart="@drawable/ic_o_camera"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Take photo" />

        <Button
            android:id="@+id/btn_camera_switch"
            style="@style/Btn.Secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/ic_o_rotate"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Switch" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_camera_play_pause"
            style="@style/Btn.Secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Pause"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_camera_quality"
            style="@style/Btn.Secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Smooth · 480p"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
