<?xml version="1.0" encoding="utf-8"?>
<!-- Orbit Cam: this phone's camera as the computer's webcam. Landscape; the picture fills the
     whole screen and the controls float over it: back and title top left, the Live pill (it
     pauses and resumes) top right, switch camera and picture size bottom right -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1B2129">

    <FrameLayout
        android:id="@+id/frame_webcam_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextureView
            android:id="@+id/tv_webcam_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- shown while paused: the computer meanwhile shows the Orbit Cam card -->
    <TextView
        android:id="@+id/tv_webcam_paused"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF1B2129"
        android:fontFamily="@font/geist_regular"
        android:gravity="center"
        android:text="Paused · the computer shows the Orbit Cam card"
        android:textColor="#FFA6AEBB"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_webcam_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/cam_pill"
        android:fontFamily="@font/geist_regular"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- top left: back, and what this is -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_webcam_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/cam_btn_round"
            android:contentDescription="Back"
            android:foreground="@drawable/ic_o_chevron_left"
            android:foregroundGravity="center"
            android:foregroundTint="#FFFFFFFF"
            android:text="" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/cam_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/geist_semibold"
                android:text="Orbit Cam"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_webcam_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/geist_regular"
                android:maxWidth="220dp"
                android:singleLine="true"
                android:text=""
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- top right: the Live pill; tapping it pauses or resumes the camera -->
    <LinearLayout
        android:id="@+id/btn_webcam_stop"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/cam_btn_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="14dp">

        <View
            android:id="@+id/v_webcam_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/cam_dot" />

        <TextView
            android:id="@+id/tv_webcam_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/geist_medium"
            android:text="Starting"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:background="#40FFFFFF" />

        <ImageView
            android:id="@+id/iv_webcam_action"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_o_pause"
            android:tint="#FFFFFFFF" />

        <TextView
            android:id="@+id/tv_webcam_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/geist_medium"
            android:text="Pause"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- bottom right: switch camera, picture size -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:background="@drawable/cam_btn_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/btn_webcam_switch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/cam_btn_clear"
            android:contentDescription="Switch camera"
            android:foreground="@drawable/ic_o_switch_camera"
            android:foregroundGravity="center"
            android:foregroundTint="#FFFFFFFF"
            android:text="" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="#40FFFFFF" />

        <Button
            android:id="@+id/btn_webcam_quality"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/cam_btn_clear"
            android:contentDescription="Picture size"
            android:fontFamily="@font/geist_semibold"
            android:includeFontPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="1080p"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
