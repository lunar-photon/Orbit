#%PAM-1.0
# Orbit - Passwordless Mobile Unlock with Password Fallback
# - Press Enter / click Unlock with empty password to approve via Phone Fingerprint.
# - Or type your Linux password and press Enter to unlock immediately via password.
auth       [success=done default=ignore] pam_exec.so expose_authtok quiet /usr/local/bin/orbit-auth-check --passwordless
auth       include                     system-local-login
account    include                     system-local-login
password   include                     system-local-login
session    include                     system-local-login
